{
  "name": "lora-full-rules",
  "note": "기준 조건. 다른 설정은 extends로 이것을 물려받고 바뀌는 칸만 적는다.",
  "model": "KORMo-Team/KORMo-10B-base",
  "model_revision": "main",
  "data": "data/20260811__annotate__v2.2/train.jsonl",
  "rules": true,
  "target": "full",
  "negatives": "keep",
  "downsample": null,
  "seed": 42,
  "max_length": 4096,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0002,
  "num_train_epochs": 3,
  "logging_steps": 5,
  "save_strategy": "epoch",
  "save_total_limit": 1,
  "gradient_checkpointing": true,
  "peft": {
    "peft_type": "LORA",
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "bias": "none"
  }
}